{
  "name": "@schemamill/core",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "The canonical schema model at the heart of schemamill.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test \"src/**/*.test.ts\"",
    "mutation": "stryker run",
    "mutation:check": "node scripts/mutation-sanity.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
